{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{"source": "/review", "destination": "/review/index.html"}],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "same-origin"}]},
    {"source": "/submission.json", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
